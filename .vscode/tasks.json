{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Jogo SFML",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/Jogo.cpp",
                "${workspaceFolder}/Jogador.cpp",
                "${workspaceFolder}/Personagem.cpp",
                "${workspaceFolder}/Entidade.cpp",
                "${workspaceFolder}/Ente.cpp",
                "${workspaceFolder}/Fase.cpp",
                "${workspaceFolder}/FaseFloresta.cpp",
                "${workspaceFolder}/Gerenciador_grafico.cpp",
                "${workspaceFolder}/Inimigo.cpp",
                "${workspaceFolder}/ListaEntidades.cpp",
                "${workspaceFolder}/chao.cpp",
                "${workspaceFolder}/menu.cpp",
                "${workspaceFolder}/Gnomo.cpp",
                "${workspaceFolder}/Mineiro.cpp",
                "-I", "C:/msys64/ucrt64/include",
                "-L", "C:/msys64/ucrt64/lib",
                "-o", "${workspaceFolder}/jogo.exe",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;C:\\msys64\\usr\\bin;${env:PATH}"
                }
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}